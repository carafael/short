[Unit]
Description=Nexus Assistant - Forever Terminal with AI Integration
Documentation=https://github.com/carafael/short
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%USER%
Group=%USER%
WorkingDirectory=%INSTALL_DIR%

# Environment
Environment="PATH=%INSTALL_DIR%/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=%INSTALL_DIR%/.env

# Execution
ExecStart=%INSTALL_DIR%/venv/bin/nexus-daemon start --max-restarts -1 --data-dir /home/%USER%/.nexus
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=%INSTALL_DIR%/venv/bin/nexus-daemon stop

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%USER%/.nexus
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=1G
CPUQuota=80%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus

[Install]
WantedBy=multi-user.target
